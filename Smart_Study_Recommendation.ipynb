    "import pandas as pd\n",
    "\n",
    "def predict_score(\n",
    "    hours,\n",
    "    attendance,\n",
    "    previous,\n",
    "    tutoring,\n",
    "    resources,\n",
    "    parental,\n",
    "    motivation,\n",
    "    peer\n",
    "):\n",
    "    \n",
    "    data = pd.DataFrame([[\n",
    "        hours,\n",
    "        attendance,\n",
    "        previous,\n",
    "        tutoring,\n",
    "        resources,\n",
    "        parental,\n",
    "        motivation,\n",
    "        peer\n",
    "    ]], columns=[\n",
    "        'Hours_Studied',\n",
    "        'Attendance',\n",
    "        'Previous_Scores',\n",
    "        'Tutoring_Sessions',\n",
    "        'Access_to_Resources',\n",
    "        'Parental_Involvement',\n",
    "        'Motivation_Level',\n",
    "        'Peer_Influence'\n",
    "    ])\n",
    "    \n",
    "    prediction = model.predict(data)[0]\n",
    "    \n",
    "    return prediction"
   ]
  },
